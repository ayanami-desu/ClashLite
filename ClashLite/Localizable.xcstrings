    "Applies only to this profile, merged before the global override. For lists, use +key to prepend and key+ to append." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只对此配置生效，在全局覆写之前合并；列表可用 +key 前置、key+ 追加"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只對此設定檔生效，在全域覆寫之前合併；清單可用 +key 前置、key+ 附加"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется только к этому профилю, объединяется перед глобальным переопределением. Для списков используйте +key, чтобы добавить в начало, и key+ — в конец."
          }
        }
      }
    },
    "Applies to all profiles, merged after the profile override. For lists, use +key to prepend and key+ to append." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对所有配置生效，在配置覆写之后合并；列表可用 +key 前置、key+ 追加"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對所有設定檔生效，在設定檔覆寫之後合併；清單可用 +key 前置、key+ 附加"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяется ко всем профилям, объединяется после переопределения профиля. Для списков используйте +key, чтобы добавить в начало, и key+ — в конец."
          }
        }
      }
    },
